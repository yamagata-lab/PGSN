<PGSNModule>
  <!--
    System record: Medical Diagnosis AI. One AI function.

    High-risk by the Art. 6(1) route rather than through Annex III: the
    software is a medical device under the Union harmonisation legislation
    listed in Annex I and requires third-party conformity assessment. None
    of the eight Annex III areas applies. A generator that only asked about
    Annex III would classify this system as minimal-risk.
  -->

  <from file="record_helpers.xml">
    <import name="doesApply"/>
    <import name="doesNotApply"/>
    <import name="noProhibitedPractice"/>
  </from>

  <def name="art5Report" as="Evidence">Art. 5 prohibited-use self-assessment report</def>
  <def name="scopeAssessment" as="Evidence">Annex III scope assessment: clinical decision support only</def>

  <def name="diagnosticSupport" as="dl">
    <dt key="name"/><dd>Diagnostic Support</dd>
    <dt key="intendedPurpose"/>
    <dd>proposing candidate findings from medical images for review by a qualified clinician, as part of a device placed on the market under the Medical Device Regulation</dd>

    <dt key="prohibitedUse"/>
    <dd><apply template="noProhibitedPractice"><arg var="art5Report"/></apply></dd>

    <dt key="classification"/>
    <dd>
      <dl>
        <dt key="Art. 6(1)"/>
        <dd><apply template="doesApply"><arg><Evidence>Class IIb medical device certificate under Regulation (EU) 2017/745, which is listed in Annex I and requires notified body conformity assessment</Evidence></arg></apply></dd>
        <dt key="Annex III, point 1"/><dd><apply template="doesNotApply"><arg var="scopeAssessment"/></apply></dd>
        <dt key="Annex III, point 2"/><dd><apply template="doesNotApply"><arg var="scopeAssessment"/></apply></dd>
        <dt key="Annex III, point 3"/><dd><apply template="doesNotApply"><arg var="scopeAssessment"/></apply></dd>
        <dt key="Annex III, point 4"/><dd><apply template="doesNotApply"><arg var="scopeAssessment"/></apply></dd>
        <dt key="Annex III, point 5"/>
        <dd><apply template="doesNotApply"><arg><Evidence>Function specification: no triage of emergency calls and no eligibility decision for healthcare services</Evidence></arg></apply></dd>
        <dt key="Annex III, point 6"/><dd><apply template="doesNotApply"><arg var="scopeAssessment"/></apply></dd>
        <dt key="Annex III, point 7"/><dd><apply template="doesNotApply"><arg var="scopeAssessment"/></apply></dd>
        <dt key="Annex III, point 8"/><dd><apply template="doesNotApply"><arg var="scopeAssessment"/></apply></dd>
      </dl>
    </dd>

    <dt key="isLimitedRisk"/><dd var="false"/>
    <dt key="isGPAI"/><dd var="false"/>
    <dt key="notGpaiAssessment"/>
    <dd><Evidence>Model architecture and capability assessment against Art. 3(63)</Evidence></dd>

    <dt key="risk_management"/><dd><Evidence>Clinical risk management system report (Art. 9)</Evidence></dd>
    <dt key="data_governance"/><dd><Evidence>Medical training data governance audit (Art. 10)</Evidence></dd>
    <dt key="technical_documentation"/><dd><Evidence>Annex IV technical documentation package (Art. 11)</Evidence></dd>
    <dt key="record_keeping"/><dd><Evidence>Automatic logging specification and test report (Art. 12)</Evidence></dd>
    <dt key="transparency_deployers"/><dd><Evidence>Instructions for use and transparency notice for deployers (Art. 13)</Evidence></dd>
    <dt key="human_oversight"/><dd><Evidence>Clinical human oversight protocol (Art. 14)</Evidence></dd>
    <dt key="accuracy_robustness"/><dd><Evidence>Diagnostic accuracy and robustness benchmark (Art. 15)</Evidence></dd>
    <dt key="quality_management_system"/><dd><Evidence>ISO 13485-aligned quality management system certificate (Art. 17)</Evidence></dd>
    <dt key="conformity_assessment"/><dd><Evidence>Notified body conformity assessment certificate (Art. 43)</Evidence></dd>
    <dt key="ce_marking"/><dd><Evidence>CE marking affixation record (Art. 48)</Evidence></dd>
    <dt key="declaration_of_conformity"/><dd><Evidence>EU declaration of conformity and EU database registration (Art. 49)</Evidence></dd>
  </def>

  <def name="system" as="dl">
    <dt key="name"/><dd>Medical Diagnosis AI</dd>
    <dt key="functionInventoryEvidence"/>
    <dd><Evidence>Annex IV technical documentation section 1(b): the device contains one AI component, the diagnostic support model</Evidence></dd>
    <dt key="functions"/>
    <dd><ol><li var="diagnosticSupport"/></ol></dd>
  </def>
</PGSNModule>
