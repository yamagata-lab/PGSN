<PGSNModule>
  <!--
    System record: General-Purpose Language Model. One AI function.

    None of the nine high-risk routes applies, so the function falls to the
    limited-risk tier under Art. 50 because it generates synthetic text. It
    is a GPAI model without systemic risk, which is orthogonal to the tier:
    Art. 53 applies, Art. 55 does not.
  -->

  <from file="record_helpers.xml">
    <import name="doesApply"/>
    <import name="doesNotApply"/>
    <import name="noProhibitedPractice"/>
  </from>

  <def name="art5Report" as="Evidence">Art. 5 prohibited-use self-assessment report</def>
  <def name="scopeAssessment" as="Evidence">Annex I and Annex III non-applicability assessment report</def>

  <def name="textGeneration" as="dl">
    <dt key="name"/><dd>Text Generation</dd>
    <dt key="intendedPurpose"/>
    <dd>generating and transforming natural language text on request, offered to downstream providers as a general-purpose model without a specific intended application</dd>

    <dt key="prohibitedUse"/>
    <dd><apply template="noProhibitedPractice"><arg var="art5Report"/></apply></dd>

    <dt key="classification"/>
    <dd>
      <dl>
        <dt key="Art. 6(1)"/><dd><apply template="doesNotApply"><arg var="scopeAssessment"/></apply></dd>
        <dt key="Annex III, point 1"/>
        <dd><apply template="doesNotApply"><arg><Evidence>Modality inventory: text-only model, no biometric input or categorisation capability</Evidence></arg></apply></dd>
        <dt key="Annex III, point 2"/><dd><apply template="doesNotApply"><arg var="scopeAssessment"/></apply></dd>
        <dt key="Annex III, point 3"/>
        <dd><apply template="doesNotApply"><arg><Evidence>Acceptable use policy: admission, grading and examination monitoring are prohibited downstream uses</Evidence></arg></apply></dd>
        <dt key="Annex III, point 4"/>
        <dd><apply template="doesNotApply"><arg><Evidence>Acceptable use policy: employment screening is a prohibited downstream use</Evidence></arg></apply></dd>
        <dt key="Annex III, point 5"/><dd><apply template="doesNotApply"><arg var="scopeAssessment"/></apply></dd>
        <dt key="Annex III, point 6"/><dd><apply template="doesNotApply"><arg var="scopeAssessment"/></apply></dd>
        <dt key="Annex III, point 7"/><dd><apply template="doesNotApply"><arg var="scopeAssessment"/></apply></dd>
        <dt key="Annex III, point 8"/><dd><apply template="doesNotApply"><arg var="scopeAssessment"/></apply></dd>
      </dl>
    </dd>

    <dt key="isLimitedRisk"/><dd var="true"/>
    <dt key="ai_disclosure_mechanism"/>
    <dd><Evidence>AI interaction disclosure implementation specification (Art. 50(1))</Evidence></dd>
    <dt key="ai_content_labeling"/>
    <dd><Evidence>Machine-readable AI-generated content marking implementation (Art. 50(2))</Evidence></dd>

    <dt key="isGPAI"/><dd var="true"/>
    <dt key="isSystemicRisk"/><dd var="false"/>
    <dt key="gpai_technical_documentation"/>
    <dd><Evidence>GPAI model technical documentation (Art. 53(1)(a))</Evidence></dd>
    <dt key="gpai_instructions_for_use"/>
    <dd><Evidence>Downstream provider integration guide (Art. 53(1)(b))</Evidence></dd>
    <dt key="copyright_policy"/>
    <dd><Evidence>Copyright compliance policy and opt-out mechanism (Art. 53(1)(c))</Evidence></dd>
    <dt key="training_data_summary"/>
    <dd><Evidence>Published training data summary (Art. 53(1)(d))</Evidence></dd>
  </def>

  <def name="system" as="dl">
    <dt key="name"/><dd>General-Purpose Language Model</dd>
    <dt key="functionInventoryEvidence"/>
    <dd><Evidence>Model card and serving architecture review: one model is exposed, with no auxiliary classifiers in the inference path</Evidence></dd>
    <dt key="functions"/>
    <dd><ol><li var="textGeneration"/></ol></dd>
  </def>
</PGSNModule>
