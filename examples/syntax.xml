<?xml version="1.0" ?>
<?xml-model href="../PGSN.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?>
<PGSN>

    <!-- ==============================
         param: variables received from outside.
         Only a <PGSNModule> takes them, so they are shown commented out:
         <PGSN> produces a value and does not accept <param>.
         ============================== -->

    <!-- a module receives A1 from its caller, and threshold with a default
    <param name="A1"/>
    <param name="threshold">100</param>
    -->


    <!-- ==============================
         import
         ============================== -->

    <!-- single import
    <from file="security.pgsn" import="secureGoal" as="G1"/>
    -->

    <!-- multiple imports using child elements
    <from file="evidence.pgsn">
        <import name="auditEvidence"/>
        <import name="testReport" as="TR"/>
    </from>
    -->

    <!-- import with parameters passed to the module
    <from file="other.pgsn">
        <import name="someGoal" as="G2"/>
        <arg name="A1" var="A1"/>
        <arg name="threshold" var="threshold"/>
    </from>
    -->


    <!-- ==============================
         def: bind a name to a value
         ============================== -->

    <!-- simple binding -->
    <def name="x">expr</def>

    <!-- variable reference -->
    <def name="varExample"><var name="x"/></def>

    <!-- anonymous function (template): expr1 is the default value, expr2 is the body -->
    <def name="f">
        <template>
            <param name="arg1">expr1</param>
            <param name="arg2"/>
            expr2
        </template>
    </def>

    <!-- template application (apply): apply f to arg1 and arg2 -->
    <def name="result">
        <apply>
            <var name="f"/>
            <arg name="arg1">expr1</arg>
            <arg name="arg2">expr2</arg>
        </apply>
    </def>

    <!-- the class the one below inherits from -->
    <def name="klass">
        <class name="klass">
            <attribute name="attr0"/>
        </class>
    </def>

    <!-- class definition: inherits from klass, with attributes and a method -->
    <def name="ClassB">
        <class name="ClassB">
            <inherit var="klass"/>
            <attribute name="attr1">C</attribute>
            <attribute name="attr2"/>
            <method name="m">
                <param name="param1">expr</param>
                <param name="param2"/>
                expr
            </method>
        </class>
    </def>

    <!-- the class the object below instantiates -->
    <def name="Ubuntu">
        <class name="Ubuntu">
            <attribute name="version"/>
            <method name="m">
                <param name="arg1"/>
                <param name="arg2"/>
                expr
            </method>
        </class>
    </def>

    <!-- object instantiation: an instance of Ubuntu -->
    <def name="ubuntu">
        <object>
            <instanceOf var="Ubuntu"/>
            <attribute name="version">20.0</attribute>
        </object>
    </def>

    <!-- type check: the value must declare at least the labels Ubuntu does -->
    <def name="checked" typeOf="Ubuntu"><var name="ubuntu"/></def>

    <!-- attribute access -->
    <def name="ver">
        <get key="version"><var name="ubuntu"/></get>
    </def>

    <!-- method invocation: call method m on ubuntu -->
    <def name="sent">
        <send method="m"><var name="ubuntu"/>
            <arg name="arg1">expr1</arg>
            <arg name="arg2">expr2</arg>
        </send>
    </def>

    <!-- local definitions -->
    <def name="localExample">
        <div>
            <def name="x">expr1</def>
            <def name="y">expr2</def>
            expr
        </div>
    </def>

    <!-- data type: a list. <ol> is the only list element, and the order of
         its items is part of what the document says -->
    <def name="aList">
        <ol>
            <li>item1</li>
            <li>item2</li>
        </ol>
    </def>

    <!-- data type: dictionary -->
    <def name="aDict">
        <dl>
            <dt>key1</dt><dd>value1</dd>
            <dt key="key2"/><dd>value2</dd>
        </dl>
    </def>

    <!-- extending a GSN node via class inheritance -->
    <def name="GoalWithURL">
        <class name="GoalWithURL">
            <inherit var="Goal"/>
            <attribute name="URL"/>
        </class>
    </def>

    <!-- GSN: a Goal supported by Evidence -->
    <def name="evidenceGoal" as="Goal">
        <description>X is secure</description>
        <Evidence>operational track record</Evidence>
    </def>

    <!-- the import that would bring in G1 is commented out above, so the
         goal is defined here instead -->
    <def name="G1" as="Goal">
        the connection is encrypted
        <Evidence>TLS configuration review</Evidence>
    </def>

    <!-- GSN: a Strategy referencing sub-goals via a variable -->
    <def name="mainStrategy" as="Strategy">
        verified through testing and review
        <subGoals>
            <ol>
                <li var="evidenceGoal"/>
                <li var="G1"/>
            </ol>
        </subGoals>
    </def>

    <!-- shorthands. Each pair below is one document written two ways:
         <tag var="x"/>                 and  <tag><var name="x"/></tag>
         <def name="x" as="tag">...</def>    <def name="x"><tag>...</tag></def>
    -->


    <!-- ==============================
         final value: the top-level Goal
         ============================== -->

    <Goal>
        <description>X is secure</description>
        <Context>certified under standard XXXX</Context>
        <Context><get key="version"><var name="ubuntu"/></get></Context>
        <Assumption>no zero-day attacks</Assumption>
        <supportedBy var="mainStrategy"/>
    </Goal>

</PGSN>