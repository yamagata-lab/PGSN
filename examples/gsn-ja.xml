    <def name="c">運用環境は社内ネットワークに限る</def>

    <def name="y_evidence" as="Evidence">第三者検証レポート</def>

    <def name="x_secure" as="Goal">
        Xはセキュア
        <Evidence>
            運用実績
        </Evidence>
    </def>

    <def name="y_secure" as="Goal">
        Yはセキュア
        <Assumption var="A1"/>
        <supportedBy var="y_evidence"/>
    </def>


    <Goal>
        Xはセキュア
        <Context>規格XXXXによる認証</Context>
        <Context var="c"/>
        <Assumption>ゼロデイ攻撃はない</Assumption>
        <Strategy>
            YYYYYY
            <subGoals>
                <ol>
                    <li var="x_secure"/>
                    <li var="y_secure"/>
                </ol>
            </subGoals>
        </Strategy>
    </Goal>

</PGSN>
