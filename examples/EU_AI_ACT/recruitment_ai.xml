<PGSNModule>
  <!--
    System record: Recruitment Screening AI. One AI function.

    High-risk through Annex III point 4. One obligation key is deliberately
    missing: `human_oversight` (Art. 14). The generator asks whether the
    record carries the key, finds that it does not, and leaves that goal
    undeveloped, so the gap appears in the case in the notation GSN already
    has for it rather than as a halted evaluation.

    Facts are not treated this way. A classification the record fails to
    answer still halts the evaluation, since there is no answer to fold in
    its place, and the evidence for the completeness of the function list is
    a mandatory key for the same reason.
  -->

  <from file="record_helpers.xml">
    <import name="doesApply"/>
    <import name="doesNotApply"/>
    <import name="noProhibitedPractice"/>
  </from>

  <def name="art5Report" as="Solution">Art. 5 prohibited-use self-assessment report</def>
  <def name="scopeAssessment" as="Solution">Annex I and Annex III scope assessment: applicant tracking only</def>

  <def name="candidateScreening" as="dl">
    <dt key="name"/><dd>Candidate Screening</dd>
    <dt key="intendedPurpose"/>
    <dd>ranking submitted applications against the requirements of a vacancy, to produce a shortlist for human review</dd>

    <dt key="prohibitedUse"/>
    <dd><apply template="noProhibitedPractice"><arg var="art5Report"/></apply></dd>

    <dt key="classification"/>
    <dd>
      <dl>
        <dt key="Art. 6(1)"/><dd><apply template="doesNotApply"><arg var="scopeAssessment"/></apply></dd>
        <dt key="Annex III, point 1"/>
        <dd><apply template="doesNotApply"><arg><Solution>Feature inventory: no biometric input; applications are processed as text</Solution></arg></apply></dd>
        <dt key="Annex III, point 2"/><dd><apply template="doesNotApply"><arg var="scopeAssessment"/></apply></dd>
        <dt key="Annex III, point 3"/><dd><apply template="doesNotApply"><arg var="scopeAssessment"/></apply></dd>
        <dt key="Annex III, point 4"/>
        <dd><apply template="doesApply"><arg><Solution>Intended purpose statement: filtering applications and ranking candidates for recruitment (Annex III, point 4(a))</Solution></arg></apply></dd>
        <dt key="Annex III, point 5"/><dd><apply template="doesNotApply"><arg var="scopeAssessment"/></apply></dd>
        <dt key="Annex III, point 6"/><dd><apply template="doesNotApply"><arg var="scopeAssessment"/></apply></dd>
        <dt key="Annex III, point 7"/><dd><apply template="doesNotApply"><arg var="scopeAssessment"/></apply></dd>
        <dt key="Annex III, point 8"/><dd><apply template="doesNotApply"><arg var="scopeAssessment"/></apply></dd>
      </dl>
    </dd>

    <dt key="isLimitedRisk"/><dd var="false"/>
    <dt key="isGPAI"/><dd var="false"/>
    <dt key="notGpaiAssessment"/>
    <dd><Solution>Model architecture and capability assessment against Art. 3(63)</Solution></dd>

    <dt key="risk_management"/><dd><Solution>Algorithmic risk management report (Art. 9)</Solution></dd>
    <dt key="data_governance"/><dd><Solution>Candidate data bias audit (Art. 10)</Solution></dd>
    <dt key="technical_documentation"/><dd><Solution>Annex IV technical documentation package (Art. 11)</Solution></dd>
    <dt key="record_keeping"/><dd><Solution>Screening decision logging specification (Art. 12)</Solution></dd>
    <dt key="transparency_deployers"/><dd><Solution>Instructions for use for HR deployers (Art. 13)</Solution></dd>

    <!-- human_oversight (Art. 14): evidence not yet available.
         The key is absent on purpose - see the header comment. -->

    <dt key="accuracy_robustness"/><dd><Solution>Screening accuracy validation report (Art. 15)</Solution></dd>
    <dt key="quality_management_system"/><dd><Solution>ISO 9001-aligned quality management system certificate (Art. 17)</Solution></dd>
    <dt key="conformity_assessment"/><dd><Solution>Internal control conformity assessment record (Art. 43)</Solution></dd>
    <dt key="ce_marking"/><dd><Solution>CE marking affixation record (Art. 48)</Solution></dd>
    <dt key="declaration_of_conformity"/><dd><Solution>EU declaration of conformity and EU database registration (Art. 49)</Solution></dd>
  </def>

  <def name="system" as="dl">
    <dt key="name"/><dd>Recruitment Screening AI</dd>
    <dt key="functionInventoryEvidence"/>
    <dd><Solution>Annex IV technical documentation section 1(b): one AI component, the ranking model</Solution></dd>
    <dt key="functions"/>
    <dd><ol><li var="candidateScreening"/></ol></dd>
  </def>
</PGSNModule>
